#!/system/bin/sh
#
# iQOO 7 宝塔面板管理脚本
# 用法: btpanel {status|start|stop|restart|install|url}
#

# 颜色定义
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    CYAN='\033[0;36m'
    NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; NC=''
fi

BTPANEL_INSTALL_DIR="/data/btpanel"
BTPANEL_FLAG_DIR="${BTPANEL_INSTALL_DIR}/.module_flags"
INSTALL_LOCK="${BTPANEL_FLAG_DIR}/install.lock"
INSTALL_LOG="${BTPANEL_INSTALL_DIR}/install.log"
# SH 解释器探测：Android 环境通常没有 bash
if command -v bash >/dev/null 2>&1; then
    SH_BIN=$(command -v bash)
elif command -v sh >/dev/null 2>&1; then
    SH_BIN=$(command -v sh)
elif [ -x /system/bin/sh ]; then
    SH_BIN=/system/bin/sh
else
    SH_BIN=/bin/sh
fi

# 查找宝塔面板
find_btpanel() {
    local paths="
        /www/server/panel/bt
        /data/btpanel/bt
        /data/btpanel/server/panel/bt
        /data/adb/btpanel/bt
        /data/btpanel/panel/bt
        /data/linux/bt
        /data/linux/www/server/panel/bt
        /usr/bin/bt
    "
    for p in $paths; do
        if [ -f "$p" ] && [ -x "$p" ]; then
            echo "$p"
            return 0
        fi
    done
    local which_bt=$(command -v bt 2>/dev/null)
    if [ -n "$which_bt" ] && [ -f "$which_bt" ]; then
        echo "$which_bt"
        return 0
    fi
    return 1
}

# 检查是否有宝塔面板残留（安装中断留下来的残缺目录）
has_btpanel_residue() {
    if [ -d "/www/server/panel" ]; then
        if [ ! -f "/www/server/panel/class/panelPlugin.py" ] || [ ! -x "/www/server/panel/bt" ]; then
            return 0
        fi
    fi
    if [ -d "${BTPANEL_INSTALL_DIR}/panel" ]; then
        if [ ! -f "${BTPANEL_INSTALL_DIR}/panel/class/panelPlugin.py" ] || [ ! -x "${BTPANEL_INSTALL_DIR}/bt" ]; then
            return 0
        fi
    fi
    return 1
}

# 检查面板是否已「完整」安装（有 bt 命令 + 有核心 class）
is_btpanel_installed() {
    local bt_bin=$(find_btpanel)
    local core_ok=0
    if [ -d "/www/server/panel" ] && [ -f "/www/server/panel/class/panelPlugin.py" ]; then core_ok=1; fi
    if [ -d "/data/btpanel/server/panel" ] && [ -f "/data/btpanel/server/panel/class/panelPlugin.py" ]; then core_ok=1; fi
    if [ -d "${BTPANEL_INSTALL_DIR}/panel" ] && [ -f "${BTPANEL_INSTALL_DIR}/panel/class/panelPlugin.py" ]; then core_ok=1; fi
    if [ -d "/data/adb/btpanel/panel" ] && [ -f "/data/adb/btpanel/panel/class/panelPlugin.py" ]; then core_ok=1; fi
    if [ -d "/data/linux/www/server/panel" ] && [ -f "/data/linux/www/server/panel/class/panelPlugin.py" ]; then core_ok=1; fi
    if [ -n "$bt_bin" ] && [ $core_ok -eq 1 ]; then return 0; fi
    return 1
}

# 获取局域网 IP
get_local_ip() {
    local ip=""
    ip=$(ip addr show wlan0 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)
    [ -z "$ip" ] && ip=$(ip addr show eth0 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1)
    [ -z "$ip" ] && ip=$(getprop dhcp.wlan0.ipaddress 2>/dev/null)
    [ -z "$ip" ] && ip=$(ifconfig 2>/dev/null | grep 'inet addr:' | grep -v '127.0.0.1' | head -1 | cut -d: -f2 | awk '{print $1}')
    [ -z "$ip" ] && ip="N/A"
    echo "$ip"
}

# 检查面板运行状态
check_status() {
    local bt_bin=$(find_btpanel)
    if [ -z "$bt_bin" ]; then
        echo "not_found"
        return
    fi

    local pid_file=""
    for f in /www/server/panel/data/bt.pid /data/btpanel/bt.pid; do
        if [ -f "$f" ]; then pid_file="$f"; break; fi
    done

    if [ -n "$pid_file" ]; then
        local pid=$(cat "$pid_file" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "running=$pid"
            return
        fi
    fi

    local status_output=$("$bt_bin" status 2>/dev/null)
    if echo "$status_output" | grep -iq "running\|started\|active"; then
        echo "running"
        return
    fi

    echo "stopped"
}

# 下载文件（v2.5.4: 同步 service.sh 的修复 — 先删旧文件 + 检查返回码 + 验证非空）
download_file() {
    local url="$1"
    local output="$2"
    local out_dir
    out_dir=$(dirname "$output" 2>/dev/null)
    [ -n "$out_dir" ] && mkdir -p "$out_dir" 2>/dev/null
    # 关键：先删除旧文件，防止下载失败后执行上次的残留脚本
    rm -f "$output" 2>/dev/null
    local rc=1
    if command -v curl >/dev/null 2>&1; then
        curl -sSLo "$output" "$url" --connect-timeout 30 --retry 3 2>&1
        rc=$?
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$output" "$url" --timeout=30 --tries=3 2>&1
        rc=$?
    else
        return 1
    fi
    # 验证：下载失败或文件为空 → 清除并返回错误
    if [ $rc -ne 0 ] || [ ! -s "$output" ]; then
        rm -f "$output" 2>/dev/null
        return 1
    fi
    return 0
}

# 设置默认账号密码
setup_default_credentials() {
    local bt_bin=$(find_btpanel)
    [ -z "$bt_bin" ] && return 1

    echo -e "${YELLOW}正在设置默认账号密码...${NC}"
    # 三层兜底：菜单 bt 5/6 管道（多次回车兼容菜单）→ default.pl crypt 哈希 → userInfo.json
    (
        printf 'admin\nadmin\nadmin\n\n\nadmin\nadmin\n' | "$bt_bin" 5 >/dev/null 2>&1
        sleep 2
        printf 'admin\nadmin\nadmin\n\n\nadmin\nadmin\n' | "$bt_bin" 6 >/dev/null 2>&1
    ) &
    local cred_pid=$!
    # 等待最多 15 秒让 bt 5/6 完成（超时不阻塞主流程）
    local waited=0
    while [ $waited -lt 15 ]; do
        kill -0 "$cred_pid" 2>/dev/null || break
        sleep 1; waited=$((waited + 1))
    done
    local pl="/www/server/panel/data/default.pl"
    [ -f "$pl" ] || pl="/data/btpanel/server/panel/data/default.pl"
    if command -v perl >/dev/null 2>&1 && [ -f "$pl" ]; then
        local hashed_pw
        hashed_pw=$(perl -e 'print crypt("admin", "42xY1BTm")' 2>/dev/null || echo "42x72Dm6gN1Ww")
        echo "$hashed_pw" > "$pl" 2>/dev/null || true
        chmod 0600 "$pl" 2>/dev/null || true
    elif [ -f "$pl" ]; then
        echo "42x72Dm6gN1Ww" > "$pl" 2>/dev/null || true
        chmod 0600 "$pl" 2>/dev/null || true
    fi
    local userfile="/www/server/panel/data/userInfo.json"
    [ -f "$userfile" ] || userfile="/data/btpanel/server/panel/data/userInfo.json"
    if [ -f "$userfile" ]; then
        sed -i 's|"username"[[:space:]]*:[[:space:]]*"[^"]*"|"username":"admin"|g' "$userfile" 2>/dev/null || true
        chmod 0600 "$userfile" 2>/dev/null || true
    fi
    echo -e "${GREEN}默认账号: admin  默认密码: admin${NC}"
}

# 显示状态
show_status() {
    echo "========================================="
    echo "   iQOO 7 宝塔面板状态监控"
    echo "========================================="
    echo ""

    local bt_bin=$(find_btpanel)
    if [ -z "$bt_bin" ]; then
        if [ -f "$INSTALL_LOCK" ]; then
            echo -e "  ${YELLOW}⚠ 宝塔面板正在安装中...${NC}"
            echo ""
            echo "  安装日志: ${INSTALL_LOG}"
            echo "  可使用 btpanel log 查看安装进度"
        elif [ -f "${BTPANEL_FLAG_DIR}/installed" ]; then
            echo -e "  ${RED}✗ 安装完成但面板文件未找到${NC}"
            echo "  请尝试: btpanel install"
        else
            echo -e "  ${RED}✗ 宝塔面板未安装${NC}"
            echo ""
            echo "  模块将在首次开机联网后自动安装"
            echo "  或手动执行: btpanel install"
        fi
        echo ""
        exit 1
    fi

    echo -e "  安装路径: ${CYAN}$bt_bin${NC}"

    local status=$(check_status)
    case "$status" in
        not_found) echo -e "  运行状态: ${RED}未安装${NC}" ;;
        stopped)   echo -e "  运行状态: ${RED}已停止${NC}" ;;
        running=*)
            local pid=${status#running=}
            echo -e "  运行状态: ${GREEN}运行中${NC}  (PID: $pid)"
            ;;
        running)   echo -e "  运行状态: ${GREEN}运行中${NC}" ;;
    esac

    local ip=$(get_local_ip)
    echo -e "  局域网 IP: ${YELLOW}$ip${NC}"
    echo ""
    echo "  面板访问地址:"
    echo -e "    ${GREEN}http://${ip}:8888${NC}"
    echo ""
    echo "  默认登录信息:"
    echo -e "    账号: ${YELLOW}admin${NC}"
    echo -e "    密码: ${YELLOW}admin${NC}"
    echo ""
    echo "  管理命令:"
    echo "    btpanel status   查看状态"
    echo "    btpanel start    启动面板"
    echo "    btpanel stop     停止面板"
    echo "    btpanel restart  重启面板"
    echo "    btpanel install  安装/重装面板"
    echo "    btpanel url      显示访问地址"
    echo "    btpanel log      查看安装日志"
    echo "========================================="
}

# 写过渡状态文件（让模块描述马上变为「启动中/停止中」）
write_state() {
    mkdir -p "${BTPANEL_FLAG_DIR}"
    echo "$1" > "${BTPANEL_FLAG_DIR}/state"
}
clear_state() {
    rm -f "${BTPANEL_FLAG_DIR}/state"
}

# 启动面板
start_panel() {
    local bt_bin=$(find_btpanel)
    if [ -z "$bt_bin" ]; then
        echo -e "${RED}错误: 未找到宝塔面板${NC}"
        echo "请先执行: btpanel install"
        exit 1
    fi

    local status=$(check_status)
    if echo "$status" | grep -q "^running"; then
        echo -e "${GREEN}宝塔面板已在运行中${NC}"
        return 0
    fi

    write_state "starting"
    echo -n "正在启动宝塔面板..."
    export BT_IGNORE=1
    nohup "$bt_bin" start >/dev/null 2>&1 &
    sleep 3

    local new_status=$(check_status)
    if echo "$new_status" | grep -q "^running"; then
        clear_state
        echo -e " ${GREEN}成功${NC}"
        local ip=$(get_local_ip)
        echo "面板地址: http://${ip}:8888"
    else
        clear_state
        echo -e " ${RED}失败${NC}"
        echo "请检查面板安装是否正确: btpanel log"
    fi
}

# 停止面板
stop_panel() {
    local bt_bin=$(find_btpanel)
    if [ -z "$bt_bin" ]; then
        echo -e "${RED}错误: 未找到宝塔面板${NC}"
        exit 1
    fi

    write_state "stopping"
    echo -n "正在停止宝塔面板..."
    "$bt_bin" stop >/dev/null 2>&1
    # 兜底强制清理进程
    sleep 2
    pkill -f "BT-Panel" >/dev/null 2>&1 || true
    pkill -f "gunicorn.*panel" >/dev/null 2>&1 || true
    clear_state
    echo -e " ${GREEN}已停止${NC}"
}

# 重启面板
restart_panel() {
    local bt_bin=$(find_btpanel)
    if [ -z "$bt_bin" ]; then
        echo -e "${RED}错误: 未找到宝塔面板${NC}"
        exit 1
    fi

    echo -n "正在重启宝塔面板..."

    write_state "stopping"
    export BT_IGNORE=1
    "$bt_bin" stop >/dev/null 2>&1
    sleep 2
    pkill -f "BT-Panel" >/dev/null 2>&1 || true
    pkill -f "gunicorn.*panel" >/dev/null 2>&1 || true
    clear_state

    write_state "starting"
    nohup "$bt_bin" start >/dev/null 2>&1 &
    sleep 3
    clear_state

    local new_status=$(check_status)
    if echo "$new_status" | grep -q "^running"; then
        echo -e " ${GREEN}成功${NC}"
        local ip=$(get_local_ip)
        echo "面板地址: http://${ip}:8888"
    else
        echo -e " ${RED}失败${NC}"
    fi
}

# 安装宝塔面板
install_panel() {
    # 情况 1：完整安装存在 → 提示重装（需要交互确认）
    if is_btpanel_installed; then
        local bt=$(find_btpanel)
        echo -e "${GREEN}✔ 检测到已安装的宝塔面板${NC}"
        echo -e "  路径: ${CYAN}$bt${NC}"
        echo -e "  状态: 已完整安装，若要重装请在下方确认"
        echo ""
        echo -e "${YELLOW}宝塔面板已安装，是否重新安装？${NC}"
        echo "  重装将会覆盖现有安装，但不会卸载已配置的站点/数据库"
        echo -n "确认重装? (y/N): "
        read -r confirm
        case "$confirm" in
            y|Y) echo -e "开始重装..." ;;
            *)   echo -e "已取消，退出。执行 btpanel start 启动现有面板。"; exit 0 ;;
        esac
    fi

    # 情况 2：残留目录 → 自动清理（不需要确认）
    if has_btpanel_residue; then
        echo -e "${YELLOW}⚠ 检测到宝塔面板残留目录，自动清理中...${NC}"
        for p in /www/server/panel/bt "${BTPANEL_INSTALL_DIR}/bt"; do
            if [ -x "$p" ]; then "$p" stop >/dev/null 2>&1; fi
        done
        pkill -f "BT-Panel" >/dev/null 2>&1 || true
        pkill -f "gunicorn.*panel" >/dev/null 2>&1 || true
        rm -f "${INSTALL_LOCK}" "${BTPANEL_FLAG_DIR}/installed"
        if [ -d "/www/server/panel" ] && [ ! -f "/www/server/panel/class/panelPlugin.py" ]; then
            rm -rf /www/server/panel 2>/dev/null || true
        fi
        if [ -d "${BTPANEL_INSTALL_DIR}/panel" ] && [ ! -f "${BTPANEL_INSTALL_DIR}/panel/class/panelPlugin.py" ]; then
            rm -rf "${BTPANEL_INSTALL_DIR}/panel" 2>/dev/null || true
        fi
        echo -e "${GREEN}✔ 残留目录已清理${NC}"
    fi

    # 检查是否已有 install.sh 进程在运行（避免两个安装进程冲突）
    if [ -f "${INSTALL_LOCK}" ]; then
        # service.sh 写入格式为 "PID timestamp"，btpanel 写入格式为 "PID"
        # 统一用 awk 只取第一个字段（PID）
        local lockpid=$(awk '{print $1}' "${INSTALL_LOCK}" 2>/dev/null)
        if [ -n "$lockpid" ] && kill -0 "$lockpid" 2>/dev/null; then
            echo -e "${YELLOW}⚠ 检测到已在运行的安装进程 (PID: $lockpid)${NC}"
            echo "  请等待安装完成，或使用: btpanel log 查看进度"
            exit 1
        else
            rm -f "${INSTALL_LOCK}"
        fi
    fi

    # 检查基础工具
    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        echo -e "${RED}错误: 未找到 curl 或 wget${NC}"
        echo "请安装 curl 或 wget"
        exit 1
    fi

    # 检查网络
    echo -e "${YELLOW}检查网络连接...${NC}"
    if ! ping -c 1 -W 3 223.5.5.5 >/dev/null 2>&1; then
        echo -e "${RED}警告: 网络似乎不通，安装可能失败${NC}"
    fi

    # 创建目录（处理 /www 只读）
    mkdir -p "${BTPANEL_FLAG_DIR}"
    if ! mkdir -p /www 2>/dev/null; then
        echo -e "${YELLOW}⚠ /www 不可写（根文件系统只读），将安装到 /data/btpanel${NC}"
        mkdir -p /data/btpanel/server /data/btpanel/wwwroot /data/btpanel/bt
        USE_DATA_FALLBACK=1
    else
        USE_DATA_FALLBACK=0
    fi

    # 日志轮转：超过 512KB 时只保留最后 1000 行
    if [ -f "$INSTALL_LOG" ]; then
        local log_size=$(wc -c < "$INSTALL_LOG" 2>/dev/null || echo 0)
        if [ "$log_size" -gt 524288 ]; then
            tail -n 1000 "$INSTALL_LOG" > "${INSTALL_LOG}.tmp" 2>/dev/null && mv "${INSTALL_LOG}.tmp" "$INSTALL_LOG"
        fi
    fi

    # 下载安装脚本
    echo -e "${YELLOW}正在下载宝塔面板安装脚本...${NC}"
    local install_script="/data/local/tmp/bt_install_panel.sh"
    mkdir -p /data/local/tmp 2>/dev/null
    if ! download_file "https://download.bt.cn/install/install_panel.sh" "$install_script"; then
        echo -e "${RED}下载安装脚本失败（DNS 解析失败？网络未就绪？）${NC}"
        echo "  检查：ping download.bt.cn 是否能解析"
        exit 1
    fi
    # 验证下载的脚本（非空 + 至少 1000 字节 + 首行是 #!）
    local script_size
    script_size=$(wc -c < "$install_script" 2>/dev/null || echo 0)
    if [ "$script_size" -lt 1000 ] 2>/dev/null; then
        echo -e "${RED}下载的安装脚本异常：文件大小 ${script_size} 字节${NC}"
        rm -f "$install_script"
        exit 1
    fi
    local first_line
    first_line=$(head -n 1 "$install_script" 2>/dev/null)
    if ! echo "$first_line" | grep -q '^#!'; then
        echo -e "${RED}下载的安装脚本首行不是 shebang：$first_line${NC}"
        rm -f "$install_script"
        exit 1
    fi
    chmod 0755 "$install_script"

    # ===== 关键：检查 bash 是否可用 =====
    # 官方 install_panel.sh 使用 bash 语法，sh/ash 无法执行
    local is_bash=0
    "$SH_BIN" -c '[[ 1 == 1 ]]' >/dev/null 2>&1 && is_bash=1
    if [ $is_bash -eq 0 ]; then
        echo -e "${YELLOW}⚠ SH_BIN=$SH_BIN 不是 bash，尝试查找系统 bash...${NC}"
        local found_bash=""
        for bp in /system/bin/bash /system/xbin/bash /data/adb/magisk/busybox/bash \
                  /data/adb/magisk/.magisk/busybox/bash /sbin/bash /usr/bin/bash; do
            if [ -x "$bp" ]; then
                found_bash="$bp"
                break
            fi
        done
        if [ -n "$found_bash" ]; then
            SH_BIN="$found_bash"
            echo -e "  ${GREEN}找到 bash: $SH_BIN${NC}"
        else
            echo -e "${RED}系统没有 bash，无法执行官方安装脚本${NC}"
            echo "  解决方案：1) 安装 busybox 完整版含 bash 2) 使用预构建包模式"
            exit 1
        fi
    fi

    # ===== 关键：准备 Android 环境 =====
    # /tmp 目录
    mkdir -p /tmp 2>/dev/null
    if [ ! -w /tmp ]; then
        mkdir -p /data/local/tmp 2>/dev/null
        mkdir -p /tmp 2>/dev/null
        mount -o bind /data/local/tmp /tmp 2>/dev/null || true
    fi
    [ ! -w /tmp ] && mount -t tmpfs tmpfs /tmp 2>/dev/null || true
    # HOME 变量
    export HOME="${HOME:-/data/btpanel}"
    [ -d "$HOME" ] || mkdir -p "$HOME" 2>/dev/null
    # /etc/ dummy 文件（Android /etc 只读）
    if [ -w /etc ]; then
        [ ! -f /etc/hostname ] && echo "android" > /etc/hostname 2>/dev/null || true
        [ ! -f /etc/issue ] && echo "Android" > /etc/issue 2>/dev/null || true
        [ ! -f /etc/redhat-release ] && echo "CentOS Linux release 7.0 (Core)" > /etc/redhat-release 2>/dev/null || true
    else
        sed -i 's|/etc/hostname|/data/btpanel/hostname|g' "$install_script" 2>/dev/null
        sed -i 's|/etc/issue|/data/btpanel/issue|g' "$install_script" 2>/dev/null
        sed -i 's|/etc/redhat-release|/data/btpanel/redhat-release|g' "$install_script" 2>/dev/null
        echo "android" > /data/btpanel/hostname 2>/dev/null || true
        echo "Android" > /data/btpanel/issue 2>/dev/null || true
        echo "CentOS Linux release 7.0 (Core)" > /data/btpanel/redhat-release 2>/dev/null || true
    fi
    # /tmp 不可写时 patch 脚本
    if [ ! -w /tmp ]; then
        sed -i 's|/tmp/|/data/local/tmp/|g' "$install_script" 2>/dev/null
    fi
    echo -e "  ${GREEN}Android 环境准备完成 (HOME=$HOME, /tmp=$( [ -w /tmp ] && echo 'OK' || echo 'FAIL' ))${NC}"

    # 如果 /www 不可写，patch 安装脚本使用 /data/btpanel
    if [ "$USE_DATA_FALLBACK" = "1" ]; then
        sed -i 's|/www/server|/data/btpanel/server|g' "$install_script" 2>/dev/null
        sed -i 's|/www/wwwroot|/data/btpanel/wwwroot|g' "$install_script" 2>/dev/null
        sed -i 's|/www/backup|/data/btpanel/backup|g' "$install_script" 2>/dev/null
        sed -i 's|/www/wwwlogs|/data/btpanel/wwwlogs|g' "$install_script" 2>/dev/null
        sed -i 's|/usr/bin/bt|/data/btpanel/bt|g' "$install_script" 2>/dev/null
        sed -i 's|/usr/bin/python|/data/btpanel/server/python/bin/python|g' "$install_script" 2>/dev/null
        sed -i 's|/etc/init.d/bt|/data/btpanel/init.d/bt|g' "$install_script" 2>/dev/null
        echo -e "${YELLOW}安装脚本已 patch: /www → /data/btpanel${NC}"
    fi

    echo -e "${YELLOW}开始安装宝塔面板（此过程可能需要 3-10 分钟）...${NC}"
    echo -e "${YELLOW}安装日志: ${INSTALL_LOG}${NC}"
    echo ""

    # 后台执行安装 + 加锁
    echo "$$" > "${INSTALL_LOCK}"
    {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] 手动安装开始（由 btpanel install 触发）..."
        echo "y" | "$SH_BIN" "$install_script" ed8484bec
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] 安装脚本执行完毕"
        rm -f "${INSTALL_LOCK}"
    } >> "${INSTALL_LOG}" 2>&1 &

    local install_pid=$!
    echo -e "安装进程 PID: ${CYAN}$install_pid${NC}"

    # 等待安装完成
    local timeout=600
    local elapsed=0
    while kill -0 "$install_pid" 2>/dev/null; do
        sleep 10
        elapsed=$((elapsed + 10))
        echo -n "."
        if [ $elapsed -ge $timeout ]; then
            echo ""
            echo -e "${RED}安装超时（${timeout}秒），终止后台安装进程...${NC}"
            # 关键：超时后必须杀掉后台安装进程，否则孤儿进程继续运行 + INSTALL_LOCK 残留
            kill -9 "$install_pid" 2>/dev/null
            pkill -9 -f "bt_install_panel.sh" 2>/dev/null || true
            pkill -9 -f "install_panel.sh" 2>/dev/null || true
            break
        fi
    done
    echo ""

    # 检查结果
    if is_btpanel_installed; then
        echo -e "${GREEN}✅ 宝塔面板安装成功！${NC}"
        setup_default_credentials
        touch "${BTPANEL_FLAG_DIR}/installed"

        # 启动面板
        export BT_IGNORE=1
        local bt_bin=$(find_btpanel)
        nohup "$bt_bin" start >/dev/null 2>&1 &
        sleep 2

        local ip=$(get_local_ip)
        echo ""
        echo "  面板访问地址: ${GREEN}http://${ip}:8888${NC}"
        echo "  账号: admin"
        echo "  密码: admin"
    else
        echo -e "${RED}❌ 安装失败${NC}"
        echo "请查看日志: btpanel log"
        echo "或手动安装: https://www.bt.cn/new/download.html"
    fi
}

# 显示访问地址
show_url() {
    local bt_bin=$(find_btpanel)
    if [ -z "$bt_bin" ]; then
        echo -e "${RED}错误: 未找到宝塔面板${NC}"
        exit 1
    fi

    local ip=$(get_local_ip)
    local status=$(check_status)
    local status_text=""
    if echo "$status" | grep -q "^running"; then
        status_text="${GREEN}[运行中]${NC}"
    else
        status_text="${RED}[已停止]${NC}"
    fi

    echo "宝塔面板 $status_text"
    echo "访问地址: http://${ip}:8888"
    echo "账号: admin / 密码: admin"
}

# 查看安装日志
show_log() {
    if [ -f "$INSTALL_LOG" ]; then
        if [ -t 1 ]; then
            less "$INSTALL_LOG"
        else
            cat "$INSTALL_LOG"
        fi
    else
        echo "暂无安装日志"
    fi
}

# ========== 主入口 ==========
case "${1:-status}" in
    status)
        show_status
        ;;
    start)
        start_panel
        ;;
    stop)
        stop_panel
        ;;
    restart)
        restart_panel
        ;;
    install)
        install_panel
        ;;
    url)
        show_url
        ;;
    log)
        show_log
        ;;
    *)
        echo "用法: btpanel {status|start|stop|restart|install|url|log}"
        echo "  status   查看运行状态和访问信息"
        echo "  start    启动宝塔面板"
        echo "  stop     停止宝塔面板"
        echo "  restart  重启宝塔面板"
        echo "  install  安装/重装宝塔面板"
        echo "  url      显示面板访问地址"
        echo "  log      查看安装日志"
        exit 1
        ;;
esac

exit 0