#!/sbin/sh
#
# Magisk 模块安装器 (通用)
#

#################
# 初始化环境
#################

# 如果 Magisk 的 busybox 可用，则使用它
if [ -f /data/adb/magisk/busybox ]; then
    BB=/data/adb/magisk/busybox
    export PATH=$($BB --list 2>/dev/null | head -100 | tr '\n' ':')$PATH
fi

OUTFD=$2
ZIPFILE=$3

# 输出函数
ui_print() {
    echo -e "ui_print $1\nui_print" >> /proc/self/fd/$OUTFD 2>/dev/null || echo "$1"
}

# 设置权限
set_perm() {
    chown $2:$3 $1 || return 1
    chmod $4 $1 || return 1
    [ -z "$5" ] && chcon 'u:object_r:system_file:s0' $1 || chcon $5 $1
    return 0
}

set_perm_recursive() {
    find $1 -type d 2>/dev/null | while read dir; do
        set_perm $dir $2 $3 $4
    done
    find $1 -type f 2>/dev/null | while read file; do
        set_perm $file $2 $3 $5
    done
}

# 解压模块
ui_print "- 正在解压模块文件"

# 获取模块路径
MODPATH=${0%/*}
# 如果 MODPATH 无效，使用临时目录
[ -z "$MODPATH" ] && MODPATH=/dev/tmp

# 创建临时工作目录
WORKDIR=/dev/tmp/btpanel_install
rm -rf $WORKDIR
mkdir -p $WORKDIR

# 解压 ZIP 到工作目录
unzip -o "$ZIPFILE" -d $WORKDIR >/dev/null 2>&1

# 复制文件到模块目录
MODTARGET=/data/adb/modules/btpanel_iqoo7
rm -rf $MODTARGET
mkdir -p $MODTARGET

# 复制所有文件
cp -af $WORKDIR/* $MODTARGET/ 2>/dev/null

# 清理临时文件
rm -rf $WORKDIR

# 设置权限
ui_print "- 正在设置文件权限"
set_perm_recursive $MODTARGET/system/bin 0 0 0755 0755
set_perm $MODTARGET/service.sh 0 0 0755
set_perm $MODTARGET/uninstall.sh 0 0 0755
[ -f $MODTARGET/customize.sh ] && set_perm $MODTARGET/customize.sh 0 0 0755

# 运行 customize.sh（如果存在）
if [ -f $MODTARGET/customize.sh ]; then
    ui_print "- 正在执行安装配置"
    chmod 0755 $MODTARGET/customize.sh
    # 在模块上下文中执行
    MODPATH=$MODTARGET /system/bin/sh $MODTARGET/customize.sh
fi

ui_print ""
ui_print "  模块安装完成！"
ui_print "  请重启设备以生效"
ui_print ""

exit 0
